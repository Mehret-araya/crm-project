# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/crmdb

# Minimum 32-byte secret for session signing in development
# Optional in development; a temporary secret is generated if omitted
SESSION_SECRET=development-session-secret-change-in-production-32-bytes

# Initial Admin bootstrap variables (for 'pnpm run seed-admin' only)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password
